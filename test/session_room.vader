" End-to-end tests for the project/name prompts and the project a session
" ends up running in. Real git worktrees, real terminal jobs, prompts answered
" with feedkeys(); the CLI itself is stood in for.
"
" The project menu lists the root checkout, then each project, then
" "+ New project…".

Before:
  call claude#session#_reset()
  call claude#room#_reset()
  call claude#store#_reset()
  call claude#panel#_reset()
  let g:_saved_cwd = getcwd()
  let g:_saved_cmd = get(g:, 'claude_cmd', 'claude')
  let g:claude_cmd = 'sleep 30'
  " --session-id/--name are never probed for with a stand-in command, but be
  " explicit: this one understands neither.
  let g:_saved_flags = get(g:, 'claude_session_flags', -1)
  let g:claude_session_flags = 0
  let g:_root = tempname()
  call mkdir(g:_root, 'p')
  let g:_root = resolve(g:_root)
  let g:_repo = g:_root . '/repo'
  call mkdir(g:_repo, 'p')
  let g:_git = 'git -C ' . shellescape(g:_repo) . ' '
  call system(g:_git . 'init -q -b main')
  call system(g:_git . 'config user.email t@t')
  call system(g:_git . 'config user.name test')
  call writefile(['hello'], g:_repo . '/file.txt')
  call system(g:_git . 'add -A')
  call system(g:_git . 'commit -qm first')
  call system(g:_git . 'branch feature-branch')
  " The transcript scan is capped by this, and other test files leave it at 0.
  let g:_saved_limit = get(g:, 'claude_panel_closed_limit', 10)
  let g:claude_panel_closed_limit = 10
  let g:claude_session_store   = g:_root . '/sessions.json'
  let g:claude_room_store      = g:_root . '/rooms.json'
  let g:claude_workspace_store = g:_root . '/workspaces.json'
  let g:claude_room_dir        = ''
  execute 'cd ' . fnameescape(g:_repo)
  let g:_transcript_dirs = []

After:
  " Any transcript directory a test fabricated. Each is named after a path
  " under g:_root, so nothing of the user's own can be caught by this.
  for d in g:_transcript_dirs
    if d =~# '/\.claude/projects/' && d =~# escape(fnamemodify(g:_root, ':t'), '\')
      call delete(d, 'rf')
    endif
  endfor
  for b in claude#session#bufnrs()
    call claude#session#stop_job(b)
    silent! execute 'bwipeout! ' . b
  endfor
  execute 'cd ' . fnameescape(g:_saved_cwd)
  let g:claude_cmd                = g:_saved_cmd
  let g:claude_session_flags      = g:_saved_flags
  let g:claude_panel_closed_limit = g:_saved_limit
  call claude#session#_reset()
  call claude#room#_reset()
  call claude#store#_reset()
  call claude#panel#_reset()
  call delete(g:_root, 'rf')
  only

Execute (a new room: the worktree is made and the session runs in it):
  call feedkeys("2\<CR>panel\<CR>\<CR>\<CR>", 't')
  let id = claude#session#new('', '')
  Assert !empty(id), 'a session should have started'
  let rec = claude#session#get(id)
  AssertEqual 'panel', rec.room
  AssertEqual 'panel', rec.name, 'an unnamed session in a new room takes its name'
  AssertEqual g:_repo . '/.vim-workspace/panel/repo', rec.cwd
  AssertEqual 'panel', rec.branch, 'a branch named after the project'
  AssertEqual g:_repo, rec.project, 'grouped under the main repo'
  AssertEqual 'run', job_status(term_getjob(rec.bufnr))

Execute (the job itself is started in the room, not in Vim's directory):
  " /bin/pwd reports the directory the process was actually given.
  let g:claude_cmd = '/bin/pwd'
  call feedkeys("2\<CR>panel\<CR>\<CR>\<CR>", 't')
  let id = claude#session#new('', '')
  let bufnr = claude#session#get(id).bufnr
  " A path wider than the terminal wraps, so read the first rows as one.
  let printed = ''
  for _ in range(50)
    let printed = ''
    for row in range(1, 4)
      let printed .= term_getline(bufnr, row)
    endfor
    let printed = trim(printed)
    if !empty(printed)
      break
    endif
    sleep 20m
  endfor
  AssertEqual g:_repo . '/.vim-workspace/panel/repo', printed

Execute (a typed session name labels the session, not the room):
  call feedkeys("2\<CR>panel\<CR>\<CR>my session\<CR>", 't')
  let id = claude#session#new('', '')
  let rec = claude#session#get(id)
  AssertEqual 'my session', rec.name
  AssertEqual 'panel',      rec.room

Execute (picking an existing room joins it: nothing is created):
  let room = claude#room#create('panel', '')
  call feedkeys("2\<CR>second\<CR>", 't')
  let id = claude#session#new('', '')
  let rec = claude#session#get(id)
  AssertEqual 'panel',   rec.room
  AssertEqual 'second',  rec.name
  AssertEqual room.path, rec.cwd
  AssertEqual 2, len(claude#room#list()), 'still just the root and panel'

Execute (a new project is the last entry, after every existing one):
  call claude#room#create('panel', '')
  call claude#room#set_current('panel')
  " root, panel, + New project — there is no sub-room entry any more
  call feedkeys("3\<CR>icons\<CR>\<CR>\<CR>", 't')
  let id = claude#session#new('', '')
  let rec = claude#session#get(id)
  AssertEqual 'icons', rec.room
  AssertEqual 'icons', rec.name
  AssertEqual 'icons', rec.branch
  AssertEqual g:_repo . '/.vim-workspace/icons/repo', rec.cwd

Execute (blank answers: the root checkout, unnamed, hidden once finished):
  call feedkeys("\<CR>\<CR>", 't')
  let id = claude#session#new('', '')
  let rec = claude#session#get(id)
  AssertEqual '',      rec.name
  AssertEqual 0,       rec.named
  AssertEqual 'root',  rec.room, 'every session in a repository has a room'
  AssertEqual g:_repo, rec.cwd
  AssertEqual ['root'], map(claude#room#list(), {_, r -> r.id}),
        \ 'no worktree was created'
  AssertEqual [id], map(copy(claude#session#list()), {_, r -> r.id})
  call claude#session#delete(id)
  AssertEqual [], claude#session#list(), 'finished and nameless: hidden'

Execute (a blank room answer keeps the selected room):
  let room = claude#room#create('panel', '')
  call claude#room#set_current('panel')
  call feedkeys("\<CR>in the room\<CR>", 't')
  let id = claude#session#new('', '')
  AssertEqual 'panel',   claude#session#get(id).room
  AssertEqual room.path, claude#session#get(id).cwd

Execute (a room that cannot be made starts no session):
  " With no default branch the question is refused at the base prompt, so
  " the name prompt is never reached.
  call feedkeys("2\<CR>panel\<CR>\<CR>", 't')
  call system(g:_git . 'branch -m main trunk')
  let id = claude#session#new('', '')
  AssertEqual '', id, 'there was nothing to cut the room from'
  AssertEqual [], claude#session#live()

Execute (resuming puts the session back in its room):
  call feedkeys("2\<CR>panel\<CR>\<CR>\<CR>", 't')
  let id = claude#session#new('', '')
  let dir = claude#session#get(id).cwd
  call claude#session#delete(id)
  AssertEqual 'closed', claude#session#status(id)
  " Resume into a window of its own: taking over this one would fail on the
  " modified scratch buffer the test harness is sitting in.
  call claude#session#resume(id, 'new')
  Assert claude#session#get(id).bufnr != -1, 'the session should be live again'
  AssertEqual dir, claude#session#get(id).cwd

Execute (with the prompts turned off the session goes in the selected room):
  let room = claude#room#create('panel', '')
  call claude#room#set_current('panel')
  let saved = g:claude_session_prompt_name
  let g:claude_session_prompt_name = 0
  try
    let id = claude#session#new('', '')
    let rec = claude#session#get(id)
    AssertEqual '',        rec.name, 'nothing was asked, so nothing was named'
    AssertEqual 'panel',   rec.room
    AssertEqual room.path, rec.cwd
  finally
    let g:claude_session_prompt_name = saved
  endtry

Execute (a name passed as an argument skips the questions):
  let id = claude#session#new('from the command line', '')
  AssertEqual 'from the command line', claude#session#get(id).name
  AssertEqual 'root', claude#session#get(id).room

" ── :ClaudeNew/:PiNew's `project:` prefix ─────────────────────────────────────

Execute (a multi-word name with no colon still just names the session):
  " :ClaudeNew fix the bug, unquoted, must keep meaning "name the session
  " 'fix the bug'" and not be misread as a room.
  call claude#new('fix the bug')
  let recs = filter(claude#session#all(), {_, r -> r.name ==# 'fix the bug'})
  AssertEqual 1, len(recs)
  AssertEqual 'root', recs[0].room, 'no room should have been made'
  AssertEqual ['root'], map(claude#room#list(), {_, r -> r.id})

Execute (a `room:` prefix makes the room and names the session):
  call claude#new('panel: Fix the fleet config')
  let recs = filter(claude#session#all(),
        \ {_, r -> r.name ==# 'Fix the fleet config'})
  AssertEqual 1, len(recs)
  let room = claude#room#get(recs[0].room)
  AssertEqual 'panel', room.id
  AssertEqual 'panel', room.branch
  AssertEqual room.path, recs[0].cwd

Execute (`room:` with nothing after names the session after the room):
  call claude#new('panel:')
  let recs = filter(claude#session#all(), {_, r -> r.room ==# 'panel'})
  AssertEqual 1, len(recs)
  AssertEqual 'panel', recs[0].name

Execute (a `room:` prefix naming an existing room joins it):
  call claude#room#create('panel', '')
  call claude#new('panel: second')
  let recs = filter(claude#session#all(), {_, r -> r.name ==# 'second'})
  AssertEqual 'panel', recs[0].room
  AssertEqual ['root', 'panel'], map(claude#room#list(), {_, r -> r.id})

Execute (`root:` runs in the root checkout):
  call claude#new('root: at home')
  let recs = filter(claude#session#all(), {_, r -> r.name ==# 'at home'})
  AssertEqual 'root', recs[0].room

Execute (a slashed name that is no project starts nothing):
  call claude#new('nope/icons: lost')
  AssertEqual [], filter(claude#session#all(), {_, r -> r.name ==# 'lost'})
  AssertEqual ['root'], map(claude#room#list(), {_, r -> r.id})

Execute (PiNew's `room:` prefix behaves exactly like ClaudeNew's):
  let g:claude_providers = {'pi': {'cmd': 'sleep 30'}}
  call claude#new('panel: a pi session', 'pi')
  let recs = filter(claude#session#all(), {_, r -> r.name ==# 'a pi session'})
  AssertEqual 1, len(recs)
  AssertEqual 'pi', claude#provider#of(recs[0])
  AssertEqual 'panel', recs[0].room
  unlet g:claude_providers

" ── surviving a restart ──────────────────────────────────────────────────────
"
" Claude files a transcript under the directory a session ran in, and a room
" session runs in its own worktree. Both halves of the registry — the store
" and the transcripts — have to look past the directory Vim happens to be in,
" or the session vanishes the next time you open Vim in the repo.

Execute (a room session is still listed, in its room, after a restart):
  call feedkeys("2\<CR>panel\<CR>\<CR>diff tree work\<CR>", 't')
  let id = claude#session#new('', '')
  for b in claude#session#bufnrs()
    call claude#session#stop_job(b)
    silent! execute 'bwipeout! ' . b
  endfor
  call claude#session#_reset()
  call claude#store#_reset()
  call claude#room#_reset()
  call claude#session#refresh()

  let recs = claude#session#list()
  AssertEqual 1, len(recs), 'the session should have come back'
  AssertEqual 'diff tree work', recs[0].name
  AssertEqual 'panel', recs[0].room
  let tree = claude#session#tree()
  AssertEqual 1, len(tree)
  AssertEqual ['root', 'panel'], map(copy(tree[0].rooms), {_, r -> r.id}),
        \ 'every room is listed, with or without sessions'
  AssertEqual [id], map(copy(tree[0].rooms[1].sessions), {_, r -> r.id})

Execute (a transcript written in a room is found from the main checkout):
  let room = claude#room#create('panel', '')
  let dir = claude#session#project_dir(room.path)
  call add(g:_transcript_dirs, dir)
  call mkdir(dir, 'p')
  call writefile([json_encode({'type': 'user', 'cwd': room.path,
        \ 'gitBranch': 'room/panel',
        \ 'message': {'content': 'rework the diff tree'}})],
        \ dir . '/11111111-2222-3333-4444-555555555555.jsonl')

  call claude#session#refresh()
  call claude#session#toggle_hidden()
  let recs = claude#session#list()
  AssertEqual 1, len(recs), 'the transcript should have been picked up'
  AssertEqual room.path, recs[0].cwd
  AssertEqual 'panel',   recs[0].room, 'placed in its room by where it ran'
  AssertEqual 'rework the diff tree', claude#session#label(recs[0])

Execute (a session stored with a workspace lands in the migrated room):
  let wt = g:_root . '/repo-feature'
  call system(g:_git . 'worktree add -q ' . shellescape(wt) . ' feature-branch')
  call writefile([json_encode({'version': 1, 'workspaces':
        \ {g:_repo: {'feature-branch': {'name': 'feature-branch',
        \   'branch': 'feature-branch', 'path': wt, 'project': g:_repo,
        \   'created': 5}}}})], g:claude_workspace_store)
  call claude#store#save({'version': 1, 'sessions':
        \ {'old': {'name': 'from before', 'named': 1,
        \          'workspace': 'feature-branch', 'cwd': wt,
        \          'project': g:_repo, 'created': 1}}})
  call claude#room#_reset()
  call claude#session#refresh()
  AssertEqual 'feature-branch', claude#session#get('old').room
  let tree = claude#session#tree()
  let rooms = map(copy(tree[0].rooms), {_, r -> r.id})
  AssertEqual ['root', 'feature-branch'], rooms

Execute (a session from another repository is not adopted):
  let other = g:_root . '/other'
  call mkdir(other, 'p')
  call system('git -C ' . shellescape(other) . ' init -q -b main')
  call claude#store#save({'version': 1, 'sessions':
        \ {'elsewhere': {'name': 'not ours', 'named': 1, 'cwd': other,
        \                'project': other, 'created': 1}}})
  call claude#session#refresh()
  AssertEqual [], claude#session#list()

" ── n in the panel ───────────────────────────────────────────────────────────

" The session n just started: the live record that was not there before it was
" pressed. live()[0] cannot be trusted here — two sessions focused in the same
" second sort by name, and every session these tests start is unnamed.
Execute (helper):
  function! LiveIds() abort
    return map(claude#session#live(), {_, r -> r.id})
  endfunction

  function! Newcomer(before) abort
    for rec in claude#session#live()
      if index(a:before, rec.id) < 0
        return rec
      endif
    endfor
    return {}
  endfunction

  " a:1 — rows to move down from the match, to press n inside a project.
  function! PressN(pattern, ...) abort
    call claude#panel#open()
    call claude#panel#_grouping('projects')
    call win_gotoid(bufwinid(claude#panel#bufnr()))
    call cursor(1, 1)
    if !empty(a:pattern)
      call search(a:pattern, 'W')
      Assert getline('.') =~# a:pattern, 'expected the row: ' . getline('.')
    endif
    if a:0 > 0
      call cursor(line('.') + a:1, 1)
    endif
    let before = LiveIds()
    let g:claude_session_prompt_name = 0
    normal n
    let g:claude_session_prompt_name = 1
    return Newcomer(before)
  endfunction

Execute (n on a project row starts a session in that project):
  call claude#room#create('panel', '')
  let other = claude#room#create('other', '')
  let new = PressN('^▾ other \[')
  AssertEqual 'other',    new.room
  AssertEqual other.path, new.cwd

Execute (n on any row inside a project starts a session there):
  call claude#room#create('panel', '')
  let other = claude#room#create('other', '')
  " The project row, then main Diff, Local Diff, Files.
  let new = PressN('^▾ other \[', 3)
  AssertEqual 'other',    new.room
  AssertEqual other.path, new.cwd

Execute (n on a session row starts a session beside it):
  let room = claude#room#create('panel', '')
  call claude#session#spawn({'room': 'panel', 'name': 'first one',
        \ 'placement': 'new'})
  let new = PressN('first one')
  AssertEqual 'panel', new.room

Execute (n on the root checkout's row starts a session there):
  call claude#room#create('panel', '')
  call claude#room#set_current('panel')
  let new = PressN('^▾ repo (root) \[')
  AssertEqual 'root',  new.room
  AssertEqual g:_repo, new.cwd, 'whatever project is selected'

Execute (n on a project row in the state view starts a session there):
  call claude#room#create('panel', '')
  call claude#session#spawn({'room': 'panel', 'name': 'busy',
        \ 'placement': 'new'})
  call claude#panel#open()
  call claude#panel#_grouping('state')
  call win_gotoid(bufwinid(claude#panel#bufnr()))
  call cursor(1, 1)
  call search('^  ▾ panel$', 'W')
  let before = LiveIds()
  let g:claude_session_prompt_name = 0
  normal n
  let g:claude_session_prompt_name = 1
  AssertEqual 'panel', Newcomer(before).room

" confirm() cannot be answered from a test, so the removal itself is covered
" by test/room_create.vader; these are the cases D settles without asking.
Execute (D on the root checkout's row deletes nothing):
  call claude#room#create('panel', '')
  call claude#panel#open()
  call win_gotoid(bufwinid(claude#panel#bufnr()))
  call cursor(1, 1)
  call search('^▾ repo (root)', 'W')
  silent! normal D
  Assert isdirectory(g:_repo)
  AssertEqual ['root', 'panel'], map(claude#room#list(), {_, r -> r.id})

Execute (D outside any project deletes nothing):
  let room = claude#room#create('panel', '')
  call claude#panel#open()
  call win_gotoid(bufwinid(claude#panel#bufnr()))
  call cursor(1, 1)
  silent! normal D
  Assert isdirectory(room.path), 'the project is kept'
  AssertEqual ['root', 'panel'], map(claude#room#list(), {_, r -> r.id})
