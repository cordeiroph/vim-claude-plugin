" Tests for rooms in the diff tree: each room drawn the way it is laid out on
" disk — room, its worktree folder, its sub-rooms — with a room diffed
" against what it was cut from and a sub-room against its room.

Before:
  call claude#difftree#_reset()
  call claude#session#_reset()
  call claude#room#_reset()
  call claude#store#_reset()
  let g:_cwd  = getcwd()
  let g:_root = resolve(tempname())
  call mkdir(g:_root, 'p')
  let g:_repo = g:_root . '/repo'
  call mkdir(g:_repo, 'p')
  let g:_g = 'git -C ' . shellescape(g:_repo) . ' '
  call system(g:_g . 'init -q -b main')
  call system(g:_g . 'config user.email t@t')
  call system(g:_g . 'config user.name test')
  call writefile(['one'], g:_repo . '/tracked.txt')
  call system(g:_g . 'add -A')
  call system(g:_g . 'commit -qm base')
  let g:_saved = [get(g:, 'claude_difftree_base', ''),
        \ get(g:, 'claude_difftree_store', ''),
        \ get(g:, 'claude_room_store', ''),
        \ get(g:, 'claude_workspace_store', ''),
        \ get(g:, 'claude_room_dir', ''),
        \ get(g:, 'claude_session_store', '')]
  let g:claude_difftree_base   = ''
  let g:claude_difftree_store  = g:_root . '/bases.json'
  let g:claude_room_store      = g:_root . '/rooms.json'
  let g:claude_workspace_store = g:_root . '/workspaces.json'
  let g:claude_room_dir        = ''
  let g:claude_session_store   = g:_root . '/sessions.json'
  execute 'cd ' . fnameescape(g:_repo)

  function! Commit(dir, file) abort
    call writefile([a:file], a:dir . '/' . a:file)
    call system('git -C ' . shellescape(a:dir) . ' add -A')
    call system('git -C ' . shellescape(a:dir) . ' commit -qm ' . a:file)
  endfunction

  function! Lines() abort
    call claude#difftree#refresh()
    call claude#difftree#open()
    return claude#difftree#_lines()
  endfunction

After:
  execute 'cd ' . fnameescape(g:_cwd)
  let [g:claude_difftree_base, g:claude_difftree_store, g:claude_room_store,
        \ g:claude_workspace_store, g:claude_room_dir,
        \ g:claude_session_store] = g:_saved
  call claude#difftree#_reset()
  call claude#session#_reset()
  call claude#room#_reset()
  call claude#store#_reset()
  call delete(g:_root, 'rf')
  silent! only

Execute (a room, its worktree folder, and a sub-room's, laid out as on disk):
  let room = claude#room#create('panel', '')
  call Commit(room.path, 'room.txt')
  let sub = claude#room#create_sub('panel', 'icons')
  call Commit(sub.path, 'sub.txt')
  let lines = Lines()
  let at = index(lines, '  ▾ panel/')
  Assert at >= 0, 'the room row: ' . string(lines)
  AssertEqual '    ▾ repo/',   lines[at + 1], 'the room''s own worktree'
  Assert lines[at + 2] =~# '^      .* room\.txt$', 'its file: ' . lines[at + 2]
  AssertEqual '    ▾ icons/',  lines[at + 3], 'the sub-room'
  AssertEqual '      ▾ repo/', lines[at + 4], 'and its worktree'
  Assert lines[at + 5] =~# '^        .* sub\.txt$', 'its file: ' . lines[at + 5]

Execute (a sub-room shows only its own work, not its room's):
  let room = claude#room#create('panel', '')
  call Commit(room.path, 'room.txt')
  let sub = claude#room#create_sub('panel', 'icons')
  call Commit(sub.path, 'sub.txt')
  call claude#difftree#refresh()
  let g:_sub = sub.path
  let files = filter(claude#difftree#files(), {_, f -> f.worktree ==# g:_sub})
  AssertEqual ['sub.txt'], map(files, {_, f -> f.path})

Execute (a room with no changes of its own is drawn for a sub-room that has):
  call claude#room#create('panel', '')
  let sub = claude#room#create_sub('panel', 'icons')
  call Commit(sub.path, 'sub.txt')
  let lines = Lines()
  let at = index(lines, '  ▾ panel/')
  Assert at >= 0, 'the room row: ' . string(lines)
  AssertEqual '    ▾ icons/', lines[at + 1],
        \ 'no folder row for the room itself: ' . string(lines)

Execute (a room with nothing changed anywhere is not drawn):
  call claude#room#create('panel', '')
  call writefile(['changed'], g:_repo . '/tracked.txt')
  let lines = Lines()
  Assert index(lines, '  ▾ panel/') < 0, 'no empty room rows: ' . string(lines)

Execute (folding a room folds its sub-rooms with it):
  let room = claude#room#create('panel', '')
  call Commit(room.path, 'room.txt')
  let sub = claude#room#create_sub('panel', 'icons')
  call Commit(sub.path, 'sub.txt')
  call Lines()
  call win_gotoid(claude#difftree#winid())
  call cursor(1, 1)
  call search('^  ▾ panel/$', 'W')
  normal za
  let text = join(claude#difftree#_lines(), "\n")
  Assert text =~# '  ▸ panel/', 'the room is shut: ' . text
  Assert text !~# 'icons', 'and its sub-rooms are hidden: ' . text

Execute (d on a room with sub-rooms is refused before anything is asked):
  let room = claude#room#create('panel', '')
  call Commit(room.path, 'room.txt')
  let sub = claude#room#create_sub('panel', 'icons')
  call Commit(sub.path, 'sub.txt')
  call Lines()
  call win_gotoid(claude#difftree#winid())
  call cursor(1, 1)
  call search('^  ▾ panel/$', 'W')
  normal d
  Assert isdirectory(room.path)
  Assert isdirectory(sub.path)

Execute (:ClaudeDiffBase on a room row sets that room's base):
  let room = claude#room#create('panel', '')
  call Commit(room.path, 'room.txt')
  call Lines()
  call win_gotoid(claude#difftree#winid())
  call cursor(1, 1)
  call search('^  ▾ panel/$', 'W')
  ClaudeDiffBase main
  Assert join(claude#difftree#_lines(), "\n") !~# '\[main\]',
        \ 'main is already the room''s base, so it is no override'
  call cursor(1, 1)
  call search('^  ▾ panel/$', 'W')
  call system(g:_g . 'branch other')
  ClaudeDiffBase other
  AssertEqual 'other', claude#difftree#base_for('room/panel')
  Assert join(claude#difftree#_lines(), "\n") =~# '\[other\] repo/',
        \ 'an override is shown on the folder row'
