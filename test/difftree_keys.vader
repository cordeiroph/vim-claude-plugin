" Tests for the diff tree's window and keys: buffer options, hiding, folding,
" and the four ways of opening a file — which must never replace a sidebar.

Before:
  call claude#difftree#_reset()
  call claude#panel#_reset()
  call claude#sidebar#_reset()
  let g:_cwd  = getcwd()
  let g:_repo = tempname()
  call mkdir(g:_repo . '/src', 'p')
  let g:_g = 'git -C ' . shellescape(g:_repo) . ' '
  call system(g:_g . 'init -q -b main')
  call system(g:_g . 'config user.email t@t')
  call system(g:_g . 'config user.name test')
  call writefile(['x'], g:_repo . '/keep.txt')
  call system(g:_g . 'add -A')
  call system(g:_g . 'commit -qm base')
  call system(g:_g . 'checkout -q -b feature')
  call writefile(['hello'], g:_repo . '/src/main.go')
  call system(g:_g . 'add -A')
  call system(g:_g . 'commit -qm work')
  " Keep the per-branch base store out of the plugin's data directory.
  let g:_saved_dtstore = get(g:, 'claude_difftree_store', '')
  let g:claude_difftree_store = g:_repo . '.bases.json'
  execute 'cd ' . fnameescape(g:_repo)

  " Line of the file row labelled {name}, or -1.
  function! FileLine(name) abort
    let l:nodes = claude#difftree#_nodes()
    for l:i in range(len(l:nodes))
      if l:nodes[l:i].kind ==# 'file' && l:nodes[l:i].label ==# a:name
        return l:i + 1
      endif
    endfor
    return -1
  endfunction

  function! GotoFile(name) abort
    call win_gotoid(bufwinid(claude#difftree#bufnr()))
    let l:line = FileLine(a:name)
    Assert l:line > 0, a:name . ' is not in the tree'
    call cursor(l:line, 1)
  endfunction

After:
  execute 'cd ' . fnameescape(g:_cwd)
  let g:claude_difftree_store = g:_saved_dtstore
  call delete(g:_repo . '.bases.json')
  call claude#difftree#_reset()
  call claude#panel#_reset()
  call claude#sidebar#_reset()
  call delete(g:_repo, 'rf')
  silent! only

" ── the window ───────────────────────────────────────────────────────────────

Execute (the panel is a fixed-width scratch buffer):
  call claude#difftree#open()
  Assert claude#difftree#is_open()
  call win_gotoid(bufwinid(claude#difftree#bufnr()))
  AssertEqual 'nofile', &buftype
  AssertEqual 'hide',   &bufhidden
  AssertEqual 0, &modifiable
  AssertEqual 0, &buflisted
  AssertEqual 0, &swapfile
  AssertEqual 1, &winfixwidth
  AssertEqual 'claudedifftree', &filetype

Execute (toggle opens and hides it):
  call claude#difftree#toggle()
  Assert claude#difftree#is_open()
  call claude#difftree#toggle()
  Assert !claude#difftree#is_open()

Execute (opening an already-open panel focuses it rather than duplicating it):
  call claude#difftree#open()
  let before = winnr('$')
  call claude#difftree#open()
  AssertEqual before, winnr('$')
  AssertEqual bufwinid(claude#difftree#bufnr()), win_getid()

Execute (q hides the panel):
  call claude#difftree#open()
  call win_gotoid(bufwinid(claude#difftree#bufnr()))
  normal q
  Assert !claude#difftree#is_open()

" ── opening files ────────────────────────────────────────────────────────────

Execute (<CR> opens the file under the cursor):
  call claude#difftree#open()
  call GotoFile('main.go')
  execute "normal \<CR>"
  AssertEqual resolve(g:_repo . '/src/main.go'), resolve(expand('%:p'))
  Assert !claude#sidebar#is_sidebar(win_getid()),
        \ 'the file must not open into a sidebar'
  Assert claude#difftree#is_open(), 'the panel must survive'

Execute (i opens the file in a horizontal split):
  call claude#difftree#open()
  call GotoFile('main.go')
  let before = winnr('$')
  normal i
  AssertEqual before + 1, winnr('$')
  AssertEqual resolve(g:_repo . '/src/main.go'), resolve(expand('%:p'))

Execute (s opens the file in a vertical split):
  call claude#difftree#open()
  call GotoFile('main.go')
  let before = winnr('$')
  normal s
  AssertEqual before + 1, winnr('$')
  AssertEqual resolve(g:_repo . '/src/main.go'), resolve(expand('%:p'))

Execute (t opens the file in a new tab):
  call claude#difftree#open()
  call GotoFile('main.go')
  let tabs = tabpagenr('$')
  normal t
  AssertEqual tabs + 1, tabpagenr('$')
  AssertEqual resolve(g:_repo . '/src/main.go'), resolve(expand('%:p'))
  tabclose

Execute (the panel window is never replaced by a file):
  call claude#difftree#open()
  call GotoFile('main.go')
  execute "normal \<CR>"
  Assert claude#difftree#is_open()
  AssertEqual claude#difftree#bufnr(),
        \ winbufnr(win_id2win(bufwinid(claude#difftree#bufnr())))

Execute (a file that no longer exists is reported, not opened):
  call claude#difftree#open()
  call delete(g:_repo . '/src/main.go')
  let rec = {'worktree': g:_repo, 'path': 'src/main.go',
        \ 'committed': 'A', 'dirty': 'D'}
  let before = bufnr('%')
  silent! call claude#difftree#open_file(rec, 'here')
  AssertEqual before, bufnr('%'), 'no buffer should have been created'

" ── folding ──────────────────────────────────────────────────────────────────

Execute (folding the project node hides everything below it):
  call claude#difftree#open()
  call win_gotoid(bufwinid(claude#difftree#bufnr()))
  Assert join(claude#difftree#_lines(), "\n") =~# 'main\.go'
  " Fold the project node, which is the first tree row.
  call cursor(3, 1)
  normal za
  Assert join(claude#difftree#_lines(), "\n") !~# 'main\.go',
        \ 'a collapsed node must hide its children'

Execute (fold state survives a rebuild):
  call claude#difftree#open()
  call win_gotoid(bufwinid(claude#difftree#bufnr()))
  call cursor(3, 1)
  normal za
  call claude#difftree#refresh()
  Assert join(claude#difftree#_lines(), "\n") !~# 'main\.go',
        \ 'the fold must survive re-running git'
  normal za
  Assert join(claude#difftree#_lines(), "\n") =~# 'main\.go'

Execute (keys on a blank line do nothing):
  call claude#difftree#open()
  call win_gotoid(bufwinid(claude#difftree#bufnr()))
  call cursor(2, 1)
  execute "normal \<CR>"
  normal i
  normal s
  Assert claude#difftree#is_open(), 'the panel should be unharmed'

" ── stacking with the session panel ──────────────────────────────────────────

Execute (the diff tree sits below the session panel):
  call claude#panel#open()
  call claude#difftree#open()
  call claude#sidebar#stack()
  let p = win_screenpos(win_id2win(claude#panel#winid()))
  let d = win_screenpos(win_id2win(claude#difftree#winid()))
  AssertEqual p[1], d[1], 'both sidebars share one column'
  Assert p[0] < d[0], 'the session panel is above the diff tree'

" ── mouse ────────────────────────────────────────────────────────────────────

Execute (a double-click activates the row, as it does in NERDTree):
  call claude#difftree#open()
  call win_gotoid(bufwinid(claude#difftree#bufnr()))
  let m = maparg('<2-LeftMouse>', 'n', 0, 1)
  Assert !empty(m), 'double-click must be mapped: Vim does not derive it from <CR>'
  AssertEqual 1, m.buffer, 'the mapping must be local to the panel'
  Assert m.rhs =~# 'activate', 'expected it to run the same action as <CR>'

Execute (double-click does exactly what <CR> does):
  " The rhs cannot be executed from a test — it carries <SID> and <CR> as
  " literal text — so compare the two mappings instead. <CR>'s own behaviour
  " (opening a file, folding a directory) is covered above.
  call claude#difftree#open()
  call win_gotoid(bufwinid(claude#difftree#bufnr()))
  AssertEqual maparg('<CR>', 'n'), maparg('<2-LeftMouse>', 'n')

" ── the worktree level ───────────────────────────────────────────────────────
"
" The tree gained a Worktree node between Project and Branch, so fold targets
" moved: line 3 is the project, 4 the worktree, 5 the branch.

Execute (the rows are project then branch, with no worktree level):
  call claude#difftree#open()
  let kinds = map(copy(claude#difftree#_nodes()), {_, n -> n.kind})
  let tree  = filter(copy(kinds),
        \ {_, k -> index(['project', 'worktree', 'branch'], k) >= 0})
  AssertEqual ['project', 'branch'], tree[0:1]
  AssertEqual -1, index(kinds, 'worktree'),
        \ 'a worktree holds one branch, so it has no row of its own'

Execute (folding the project hides every branch):
  call claude#difftree#open()
  call win_gotoid(bufwinid(claude#difftree#bufnr()))
  call cursor(3, 1)
  normal za
  let t = join(claude#difftree#_lines(), "\n")
  Assert t !~# 'main\.go',  'folding the project hides its branches'
  Assert t !~# '▾ feature', 'the branch row goes with it'
  Assert t =~# fnamemodify(g:_repo, ':t'), 'the project row stays'
  normal za
  Assert join(claude#difftree#_lines(), "\n") =~# 'main\.go'

Execute (a branch folds without hiding the project):
  call claude#difftree#open()
  call win_gotoid(bufwinid(claude#difftree#bufnr()))
  let nodes = claude#difftree#_nodes()
  let bline = -1
  for i in range(len(nodes))
    if nodes[i].kind ==# 'branch' | let bline = i + 1 | break | endif
  endfor
  Assert bline > 0, 'expected a branch row'
  call cursor(bline, 1)
  normal za
  let t = join(claude#difftree#_lines(), "\n")
  Assert t !~# 'main\.go',   'folding a branch hides its files'
  Assert t =~# '▸ feature',  'the branch row itself stays, marked collapsed'
  Assert t =~# fnamemodify(g:_repo, ':t'), 'the project row stays'

" ── the shared column keeps its width ────────────────────────────────────────
"
" Regression: a sidebar used to open as its own vertical column and then be
" folded into the shared one by win_splitmove(). Merging two sidebar columns
" leaves the survivor too wide — a 35-column session panel became 62 when the
" diff tree opened beside it — because Vim gives the freed width to the
" remaining column rather than back to the main area, and it stayed wrong even
" after the second sidebar closed. Sidebars now split inside the existing
" column, so there is never a second one to merge.

Execute (opening the diff tree does not widen the session panel):
  call claude#panel#open()
  let width = winwidth(win_id2win(claude#panel#winid()))
  AssertEqual g:claude_panel_width, width
  call claude#difftree#open()
  AssertEqual width, winwidth(win_id2win(claude#panel#winid())),
        \ 'the session panel must keep its width'
  AssertEqual width, winwidth(win_id2win(claude#difftree#winid())),
        \ 'both sidebars share the one column width'

Execute (it does not widen it in the other order either):
  call claude#difftree#open()
  let width = winwidth(win_id2win(claude#difftree#winid()))
  call claude#panel#open()
  AssertEqual width, winwidth(win_id2win(claude#difftree#winid()))
  AssertEqual width, winwidth(win_id2win(claude#panel#winid()))

Execute (closing one gives the width back rather than to the survivor):
  call claude#panel#open()
  let width = winwidth(win_id2win(claude#panel#winid()))
  call claude#difftree#open()
  call claude#difftree#close()
  AssertEqual width, winwidth(win_id2win(claude#panel#winid())),
        \ 'the survivor must not absorb the closed sidebar''s width'

Execute (the editor keeps its width throughout):
  call claude#panel#open()
  call claude#sidebar#enter_main(-1)
  let main = winwidth(0)
  Assert main > 0, 'expected a main window'
  call claude#difftree#open()
  call claude#sidebar#enter_main(-1)
  AssertEqual main, winwidth(0),
        \ 'opening a sidebar must not steal width from the editor'
