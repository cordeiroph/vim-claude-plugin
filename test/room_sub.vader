" Tests for sub-rooms — cut from their room, listed under it, diffed against
" it — and for claude#room#ask(), the question a new session starts with.
" Real fixture repository; no terminal, no Claude process.

Before:
  call claude#room#_reset()
  call claude#store#_reset()
  call claude#difftree#_reset()
  let g:_saved_cwd     = getcwd()
  let g:_saved_store   = get(g:, 'claude_room_store', '')
  let g:_saved_wstore  = get(g:, 'claude_workspace_store', '')
  let g:_saved_dir     = get(g:, 'claude_room_dir', '')
  let g:_saved_dtstore = get(g:, 'claude_difftree_store', '')
  let g:_saved_base    = get(g:, 'claude_difftree_base', '')

  let g:_root = tempname()
  call mkdir(g:_root, 'p')
  let g:_root = resolve(g:_root)
  let g:_repo = g:_root . '/repo'
  call mkdir(g:_repo, 'p')
  let g:_git  = 'git -C ' . shellescape(g:_repo) . ' '
  call system(g:_git . 'init -q -b main')
  call system(g:_git . 'config user.email t@t')
  call system(g:_git . 'config user.name test')
  call writefile(['hello'], g:_repo . '/file.txt')
  call system(g:_git . 'add -A')
  call system(g:_git . 'commit -qm first')

  let g:claude_room_store      = g:_root . '/rooms.json'
  let g:claude_workspace_store = g:_root . '/workspaces.json'
  let g:claude_room_dir        = ''
  let g:claude_difftree_store  = g:_root . '/bases.json'
  let g:claude_difftree_base   = ''
  execute 'cd ' . fnameescape(g:_repo)

  function! Commit(dir, file) abort
    call writefile([a:file], a:dir . '/' . a:file)
    call system('git -C ' . shellescape(a:dir) . ' add -A')
    call system('git -C ' . shellescape(a:dir) . ' commit -qm ' . a:file)
  endfunction

  function! Ids() abort
    return map(claude#room#list(), {_, r -> r.id})
  endfunction

After:
  execute 'cd ' . fnameescape(g:_saved_cwd)
  let g:claude_room_store      = g:_saved_store
  let g:claude_workspace_store = g:_saved_wstore
  let g:claude_room_dir        = g:_saved_dir
  let g:claude_difftree_store  = g:_saved_dtstore
  let g:claude_difftree_base   = g:_saved_base
  call claude#room#_reset()
  call claude#store#_reset()
  call claude#difftree#_reset()
  call delete(g:_root, 'rf')

" ── creating ─────────────────────────────────────────────────────────────────

Execute (a sub-room sits beside its room's worktree, on room/<room>--<sub>):
  let room = claude#room#create('panel', '')
  let sub  = claude#room#create_sub('panel', 'icons')
  Assert !empty(sub), 'a sub-room should have been created'
  AssertEqual 'panel/icons',              sub.id
  AssertEqual 'icons',                    sub.name
  AssertEqual 'panel',                    sub.parent
  AssertEqual 'room/panel--icons',        sub.branch
  AssertEqual 'room/panel',               sub.base, 'it diffs against its room'
  AssertEqual g:_repo . '/.vim-workspace/panel/icons/repo', sub.path
  AssertEqual [], systemlist('git -C ' . shellescape(room.path)
        \ . ' status --porcelain'),
        \ 'the sub-room is not an untracked directory inside the room'

Execute (a sub-room starts from the room's last commit):
  let room = claude#room#create('panel', '')
  call Commit(room.path, 'in-room.txt')
  let sub = claude#room#create_sub('panel', 'icons')
  Assert filereadable(sub.path . '/in-room.txt'),
        \ 'committed work in the room is carried over'

Execute (uncommitted work in the room is not carried over):
  let room = claude#room#create('panel', '')
  call writefile(['wip'], room.path . '/wip.txt')
  Assert claude#room#is_dirty(room)
  let sub = claude#room#create_sub('panel', 'icons')
  Assert !filereadable(sub.path . '/wip.txt')

Execute (sub-rooms are listed under their room, oldest first):
  call claude#room#create('panel', '')
  call claude#room#create('other', '')
  call claude#room#create_sub('panel', 'icons')
  call claude#room#create_sub('panel', 'layout')
  AssertEqual ['root', 'panel', 'panel/icons', 'panel/layout', 'other'], Ids()
  AssertEqual ['panel/icons', 'panel/layout'],
        \ map(claude#room#children('panel'), {_, r -> r.id})
  AssertEqual [], claude#room#children('other')

Execute (sub-room names are unique within their room only):
  call claude#room#create('panel', '')
  call claude#room#create('other', '')
  call claude#room#create_sub('panel', 'icons')
  AssertEqual 'icons-1', claude#room#unique_name('icons', 'panel')
  AssertEqual 'icons',   claude#room#unique_name('icons', 'other')

Execute (only a room can hold sub-rooms):
  call claude#room#create('panel', '')
  call claude#room#create_sub('panel', 'icons')
  AssertEqual {}, claude#room#create_sub('root', 'x'), 'not the root checkout'
  AssertEqual {}, claude#room#create_sub('panel/icons', 'x'), 'not a sub-room'
  AssertEqual {}, claude#room#create_sub('nope', 'x'), 'not an unknown room'
  AssertEqual ['root', 'panel', 'panel/icons'], Ids()

" ── removing ─────────────────────────────────────────────────────────────────

Execute (a room with sub-rooms is refused, never removed with them):
  let room = claude#room#create('panel', '')
  let sub  = claude#room#create_sub('panel', 'icons')
  Assert !claude#room#force_remove('panel'), 'refused even with force'
  Assert isdirectory(room.path)
  Assert isdirectory(sub.path)

  Assert claude#room#remove('panel/icons')
  Assert !isdirectory(g:_repo . '/.vim-workspace/panel/icons'),
        \ 'the sub-room directory goes with it'
  Assert isdirectory(room.path), 'and its room is untouched'
  Assert claude#room#remove('panel'), 'with no sub-rooms left, it goes'

Execute (a room deleted by hand is kept while its sub-rooms are there):
  let room = claude#room#create('panel', '')
  let sub  = claude#room#create_sub('panel', 'icons')
  call system(g:_git . 'worktree remove ' . shellescape(room.path))
  AssertEqual ['root', 'panel', 'panel/icons'], Ids()
  let gone = claude#room#get('panel')
  AssertEqual 1, gone.missing
  AssertEqual 'panel — (missing)', claude#room#label(gone)

  call system(g:_git . 'worktree remove ' . shellescape(sub.path))
  AssertEqual ['root'], Ids(), 'with nothing left in it, it is pruned'

" ── looking rooms up ─────────────────────────────────────────────────────────

Execute (a worktree path names its room):
  let room = claude#room#create('panel', '')
  let sub  = claude#room#create_sub('panel', 'icons')
  AssertEqual 'panel',       claude#room#of_path(room.path)
  AssertEqual 'panel/icons', claude#room#of_path(sub.path)
  AssertEqual 'root',        claude#room#of_path(g:_repo)
  AssertEqual '',            claude#room#of_path(g:_root)

Execute (a branch names the base its room diffs against):
  call claude#room#create('panel', '')
  call claude#room#create_sub('panel', 'icons')
  AssertEqual 'main',       claude#room#base_of_branch('room/panel')
  AssertEqual 'room/panel', claude#room#base_of_branch('room/panel--icons')
  AssertEqual '',           claude#room#base_of_branch('main')

" ── the diff tree's base ─────────────────────────────────────────────────────

Execute (the diff tree diffs a sub-room against its room):
  call claude#room#create('panel', '')
  call claude#room#create_sub('panel', 'icons')
  AssertEqual 'room/panel', claude#difftree#base_for('room/panel--icons')
  AssertEqual 'main',       claude#difftree#base_for('room/panel')
  Assert !claude#difftree#has_override('room/panel--icons'),
        \ 'a room base is not shown as an override'

Execute (an explicit base wins, and clearing it falls back to the room's):
  call claude#room#create('panel', '')
  call claude#room#create_sub('panel', 'icons')
  call claude#difftree#set_branch_base('room/panel--icons', 'main')
  AssertEqual 'main', claude#difftree#base_for('room/panel--icons')
  Assert claude#difftree#has_override('room/panel--icons'),
        \ 'main is the default, but not this branch''s base, so it is shown'
  call claude#difftree#set_branch_base('room/panel--icons', '')
  AssertEqual 'room/panel', claude#difftree#base_for('room/panel--icons')

Execute (a room base that no longer resolves falls back to the default):
  call claude#room#create('panel', '')
  call claude#room#create_sub('panel', 'icons')
  call system(g:_git . 'branch -m room/panel room/renamed')
  call claude#difftree#refresh()
  AssertEqual 'main', claude#difftree#base_for('room/panel--icons')

" ── asking where a new session goes ──────────────────────────────────────────
"
" The menu is the root checkout, then each room and its sub-rooms, then the
" two ways to make a new one.

Execute (an existing room is picked by its number):
  call claude#room#create('panel', '')
  call claude#room#create_sub('panel', 'icons')
  call feedkeys("3\<CR>", 't')
  AssertEqual [1, {'room': 'panel/icons'}], claude#room#ask()

Execute (a blank answer keeps the selected room):
  call claude#room#create('panel', '')
  call feedkeys("\<CR>", 't')
  AssertEqual [1, {'room': 'root'}], claude#room#ask()
  call claude#room#set_current('panel')
  call feedkeys("\<CR>", 't')
  AssertEqual [1, {'room': 'panel'}], claude#room#ask()

Execute (a new room asks for a name and a base, and creates nothing yet):
  call feedkeys("2\<CR>panel\<CR>\<CR>", 't')
  AssertEqual [1, {'new': 'room', 'name': 'panel', 'base': ''}],
        \ claude#room#ask()
  AssertEqual ['root'], Ids(), 'creation waits for every answer'

Execute (an unknown base is refused at the prompt):
  call feedkeys("2\<CR>panel\<CR>no-such-branch\<CR>", 't')
  AssertEqual [0, {}], claude#room#ask()

Execute (a new sub-room goes in the selected room without asking which):
  call claude#room#create('panel', '')
  call claude#room#create('other', '')
  call claude#room#set_current('other')
  " root, panel, other, new room, new sub-room
  call feedkeys("5\<CR>icons\<CR>", 't')
  AssertEqual [1, {'new': 'sub', 'parent': 'other', 'name': 'icons'}],
        \ claude#room#ask()

Execute (with the root checkout selected, the sub-room's room is asked for):
  call claude#room#create('panel', '')
  call claude#room#create('other', '')
  call feedkeys("5\<CR>1\<CR>icons\<CR>", 't')
  AssertEqual [1, {'new': 'sub', 'parent': 'panel', 'name': 'icons'}],
        \ claude#room#ask()

Execute (the answer is realised into a room):
  let room = claude#room#realise({'new': 'room', 'name': 'panel', 'base': ''})
  AssertEqual 'panel', room.id
  let sub = claude#room#realise({'new': 'sub', 'parent': 'panel',
        \ 'name': 'icons'})
  AssertEqual 'panel/icons', sub.id
  AssertEqual 'panel', claude#room#realise({'room': 'panel'}).id
  AssertEqual {}, claude#room#realise({'room': ''})
