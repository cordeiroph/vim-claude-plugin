" Tests for g, the key that swaps the panel's top level between the projects
" and what sessions are doing, and for the fold state each view keeps. The cwd
" is not a repository, so in the projects view sessions sit under Elsewhere.

Before:
  call claude#session#_reset()
  call claude#panel#_reset()
  call claude#store#_reset()
  let g:_saved_store = get(g:, 'claude_session_store', '')
  let g:_saved_cwd   = getcwd()
  let g:_dir = tempname()
  call mkdir(g:_dir, 'p')
  let g:claude_session_store = g:_dir . '/sessions.json'
  execute 'cd ' . fnameescape(g:_dir)

After:
  execute 'cd ' . fnameescape(g:_saved_cwd)
  call claude#panel#_reset()
  call claude#session#_reset()
  call claude#store#_reset()
  let g:claude_session_store = g:_saved_store
  call delete(g:_dir, 'rf')
  only

Execute (helper):
  function! Panel() abort
    call claude#session#_inject({'name': 'panel rework', 'status': 'active',
          \ 'project': '/w/alpha', 'worktree': '/w/alpha', 'branch': 'main'})
    call claude#panel#open()
    call win_gotoid(bufwinid(claude#panel#bufnr()))
  endfunction

" ── the swap ─────────────────────────────────────────────────────────────────

Execute (g swaps the top level, and back again):
  call Panel()
  AssertEqual 'projects', claude#panel#_grouping(), 'the panel opens on projects'
  Assert claude#panel#_lines()[0] =~# '^Projects'

  normal g
  AssertEqual 'state', claude#panel#_grouping()
  let text = join(claude#panel#_lines(), "\n")
  Assert text =~# '▾ Working',          'now it is the state view: ' . text
  Assert text =~# '  ▾ alpha (root)',   'with the project under the group'
  Assert claude#panel#_lines()[0] =~# '^Claude Sessions'

  normal g
  AssertEqual 'projects', claude#panel#_grouping()
  Assert join(claude#panel#_lines(), "\n") !~# 'Working'

Execute (the same session sits under its project in both views):
  call Panel()
  let proj = filter(claude#panel#_lines(), {_, l -> l =~# 'panel rework'})[0]
  normal g
  let lines = claude#panel#_lines()
  let state = filter(copy(lines), {_, l -> l =~# 'panel rework'})[0]
  Assert index(lines, '  ▾ alpha (root)') >= 0, 'a project row: ' . string(lines)
  Assert state =~# '^    ●', 'under the project in the state view: ' . state
  Assert proj =~# '^    ●',  'and in the projects view: ' . proj

Execute (the header follows you across):
  call claude#session#_inject({'name': 'asking', 'status': 'waiting'})
  call claude#panel#open()
  call win_gotoid(bufwinid(claude#panel#bufnr()))
  Assert claude#panel#_lines()[0] =~# '1 waiting$'
  normal g
  Assert claude#panel#_lines()[0] =~# '1 waiting$',
        \ 'who needs you is the question in either view'

" ── folds ────────────────────────────────────────────────────────────────────

Execute (each view keeps its own folds across a swap):
  call Panel()
  " Fold the Working group in the state view.
  normal g
  call cursor(1, 1)
  call search('Working', 'W')
  normal za
  Assert join(claude#panel#_lines(), "\n") !~# 'panel rework'

  " The projects view is unaffected: its keys are its own.
  normal g
  Assert join(claude#panel#_lines(), "\n") =~# 'panel rework',
        \ 'a state fold must not fold a project'

  " Fold Elsewhere too.
  call cursor(1, 1)
  call search('Elsewhere', 'W')
  normal za
  Assert join(claude#panel#_lines(), "\n") !~# 'panel rework'

  " Both folds are still there on the way back.
  normal g
  Assert join(claude#panel#_lines(), "\n") !~# 'panel rework',
        \ 'the state fold survived the round trip'
  call cursor(1, 1)
  call search('Working', 'W')
  normal za
  Assert join(claude#panel#_lines(), "\n") =~# 'panel rework'
  normal g
  Assert join(claude#panel#_lines(), "\n") !~# 'panel rework',
        \ 'and so did the projects fold'

" ── what a reset restores ────────────────────────────────────────────────────

Execute (a reset puts the view, the folds and the tail back):
  call Panel()
  normal g
  call cursor(1, 1)
  call search('Working', 'W')
  normal za
  AssertEqual 'state', claude#panel#_grouping()

  call claude#panel#_reset()
  call claude#panel#open()
  AssertEqual 'projects', claude#panel#_grouping(), 'the default view is back'
  call claude#panel#_grouping('state')
  call claude#session#_inject({'name': 'finished', 'status': 'closed'})
  call claude#panel#refresh()
  let text = join(claude#panel#_lines(), "\n")
  Assert text =~# '▸ Done',    'Done is shut again'
  Assert text =~# '▾ Working', 'and Working open again'

Execute (the help block names the key):
  call claude#panel#open()
  call win_gotoid(bufwinid(claude#panel#bufnr()))
  normal ?
  let text = join(claude#panel#_lines(), "\n")
  Assert text =~# 'g by status', 'the help should offer the swap: ' . text
  Assert text =~# '/ filter',    'and the filter'
  Assert text =~# 'N new project', 'and the project keys'
  normal g
  Assert join(claude#panel#_lines(), "\n") =~# 'g projects',
        \ 'and say where it would take you from here'
