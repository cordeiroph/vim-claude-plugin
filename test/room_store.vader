" Tests for the room store: where it lives, what it holds, and the one-time
" migration from the workspace store it replaced.

Before:
  call claude#room#_reset()
  call claude#store#_reset()
  let g:_saved_cwd    = getcwd()
  let g:_saved_store  = get(g:, 'claude_room_store', '')
  let g:_saved_wstore = get(g:, 'claude_workspace_store', '')
  let g:_saved_dir    = get(g:, 'claude_room_dir', '')

  let g:_root = tempname()
  call mkdir(g:_root, 'p')
  let g:_root = resolve(g:_root)
  let g:_repo = g:_root . '/repo'
  call mkdir(g:_repo, 'p')
  let g:_git  = 'git -C ' . shellescape(g:_repo) . ' '
  call system(g:_git . 'init -q -b main')
  call system(g:_git . 'config user.email t@t')
  call system(g:_git . 'config user.name test')
  call writefile(['hello'], g:_repo . '/file.txt')
  call system(g:_git . 'add -A')
  call system(g:_git . 'commit -qm first')

  let g:_path  = g:_root . '/rooms.json'
  let g:_wpath = g:_root . '/workspaces.json'
  let g:claude_room_store      = g:_path
  let g:claude_workspace_store = g:_wpath
  let g:claude_room_dir        = ''
  execute 'cd ' . fnameescape(g:_repo)

After:
  execute 'cd ' . fnameescape(g:_saved_cwd)
  let g:claude_room_store      = g:_saved_store
  let g:claude_workspace_store = g:_saved_wstore
  let g:claude_room_dir        = g:_saved_dir
  call claude#room#_reset()
  call claude#store#_reset()
  call delete(g:_root, 'rf')

" ── path resolution ──────────────────────────────────────────────────────────

Execute (path honours g:claude_room_store):
  AssertEqual g:_path, claude#store#room_path()

Execute (path falls back to data/rooms.json inside the plugin):
  let g:claude_room_store = ''
  let path = claude#store#room_path()
  Assert path =~# 'data/rooms\.json$',
        \ 'default store should live in the plugin data dir, got ' . path

" ── round trip ───────────────────────────────────────────────────────────────

Execute (a created room survives a reload of the store):
  let room = claude#room#create('panel', '')
  call claude#room#create_sub('panel', 'icons')
  call claude#store#_reset()
  call claude#room#_reset()
  let back = claude#room#get('panel')
  AssertEqual room.branch, back.branch
  AssertEqual room.base,   back.base
  AssertEqual room.path,   back.path
  AssertEqual 'panel', claude#room#get('panel/icons').parent

Execute (rooms are keyed by repository root, and the root is never stored):
  call claude#room#create('panel', '')
  let data = json_decode(join(readfile(g:_path), "\n"))
  AssertEqual 1, data.version
  AssertEqual ['panel'], keys(data.rooms[g:_repo])
  AssertEqual 'room/panel', data.rooms[g:_repo].panel.branch
  Assert !has_key(data.rooms[g:_repo].panel, 'missing'),
        \ 'runtime-only fields are not written'

Execute (a corrupt store is backed up and read as empty):
  call writefile(['{not json'], g:_path)
  call claude#room#_reset()
  AssertEqual ['root'], map(claude#room#list(), {_, r -> r.id})
  Assert filereadable(g:_path . '.bak'),
        \ 'the unreadable store should have been kept'

Execute (a record missing fields loads with them filled in):
  call mkdir(g:_root . '/somewhere', 'p')
  call writefile([json_encode({'version': 1, 'rooms':
        \ {g:_repo: {'old': {'path': g:_root . '/somewhere'}}}})], g:_path)
  call claude#room#_reset()
  let room = claude#room#get('old')
  AssertEqual 'old', room.name, 'the id stands in for a missing name'
  AssertEqual '',    room.parent
  AssertEqual '',    room.base, 'no base means the default'
  AssertEqual 0,     room.legacy

Execute (a record whose directory is gone is dropped and written back):
  call writefile([json_encode({'version': 1, 'rooms':
        \ {g:_repo: {'ghost': {'name': 'ghost', 'branch': 'x',
        \                      'path': g:_root . '/gone', 'project': g:_repo,
        \                      'created': 1}}}})], g:_path)
  call claude#room#_reset()
  AssertEqual ['root'], map(claude#room#list(), {_, r -> r.id})
  let data = json_decode(join(readfile(g:_path), "\n"))
  AssertEqual {}, data.rooms[g:_repo],
        \ 'the pruned list should have been persisted'

" ── migration ────────────────────────────────────────────────────────────────

Execute (each workspace becomes a legacy room where it already is):
  let wt = g:_root . '/repo-feature'
  call system(g:_git . 'worktree add -q -b feature ' . shellescape(wt))
  call writefile([json_encode({'version': 1, 'workspaces':
        \ {g:_repo: {'feature': {'id': 'feature', 'name': 'feature',
        \   'branch': 'feature', 'path': wt, 'project': g:_repo,
        \   'created': 5}}}})], g:_wpath)
  let before = readfile(g:_wpath)
  call claude#room#_reset()

  let room = claude#room#get('feature')
  Assert !empty(room), 'the workspace should have become a room'
  AssertEqual wt,        room.path, 'nothing was moved'
  AssertEqual 'feature', room.branch
  AssertEqual '',        room.parent
  AssertEqual '',        room.base, 'it diffs against the default, as before'
  AssertEqual 1,         room.legacy
  AssertEqual 'feature — feature', claude#room#label(room),
        \ 'its branch is not room/<name>, so the label says it'
  Assert filereadable(g:_path), 'the room store was written'
  AssertEqual before, readfile(g:_wpath),
        \ 'the workspace store is left as it was'

Execute (a legacy room can hold sub-rooms, which go under .vim-workspace):
  let wt = g:_root . '/repo-feature'
  call system(g:_git . 'worktree add -q -b feature ' . shellescape(wt))
  call writefile([json_encode({'version': 1, 'workspaces':
        \ {g:_repo: {'feature': {'name': 'feature', 'branch': 'feature',
        \   'path': wt, 'project': g:_repo, 'created': 5}}}})], g:_wpath)
  call claude#room#_reset()
  let sub = claude#room#create_sub('feature', 'try')
  AssertEqual 'feature', sub.base
  AssertEqual g:_repo . '/.vim-workspace/feature/try/repo', sub.path

Execute (migration happens once: a room store that exists is not rebuilt):
  call claude#room#create('panel', '')
  call writefile([json_encode({'version': 1, 'workspaces':
        \ {g:_repo: {'late': {'name': 'late', 'path': g:_root}}}})], g:_wpath)
  call claude#room#_reset()
  AssertEqual {}, claude#room#get('late')
  Assert !empty(claude#room#get('panel'))
