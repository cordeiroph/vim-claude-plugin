" Tests for the panel's rendering: projects in both views, the status glyphs,
" duplicate-name disambiguation and folding. Records are fabricated, so no
" Claude process is ever started. Most of these are about session rows, so
" they run in the state view; the projects view is set where it is the point.
" The cwd is not a repository, so every session there sits under Elsewhere.

Before:
  call claude#session#_reset()
  call claude#panel#_reset()
  let g:_saved_store = get(g:, 'claude_session_store', '')
  let g:_store_dir = tempname()
  call mkdir(g:_store_dir, 'p')
  let g:claude_session_store = g:_store_dir . '/sessions.json'
  call claude#store#_reset()
  " Work from an empty directory so the on-disk transcripts of the real
  " project never leak into the assertions.
  let g:_orig_cwd = getcwd()
  let g:_empty = tempname()
  call mkdir(g:_empty, 'p')
  execute 'cd ' . fnameescape(g:_empty)
  let g:_saved_ascii = get(g:, 'claude_panel_ascii', 0)
  call claude#panel#_grouping('state')

After:
  call claude#panel#_reset()
  call claude#session#_reset()
  execute 'cd ' . fnameescape(g:_orig_cwd)
  let g:claude_panel_ascii   = g:_saved_ascii
  let g:claude_session_store = g:_saved_store
  call claude#store#_reset()
  call delete(g:_empty, 'rf')
  call delete(g:_store_dir, 'rf')
  only

" ── empty state ──────────────────────────────────────────────────────────────

Execute (an empty registry renders the placeholder, not an empty buffer):
  call claude#panel#open()
  let lines = claude#panel#_lines()
  Assert lines[0] =~# '^Claude Sessions',   'expected a header'
  Assert lines[0] =~# '(0)$',               'expected a live count of 0'
  Assert index(lines, '  (no sessions)') >= 0,
        \ 'expected the empty placeholder, got ' . string(lines)

" ── grouping ─────────────────────────────────────────────────────────────────

Execute (the projects view opens on a repository's projects):
  call claude#panel#_reset()
  call claude#panel#open()
  AssertEqual 'projects', claude#panel#_grouping(), 'the default view'
  let lines = claude#panel#_lines()
  Assert lines[0] =~# '^Projects', 'expected the projects header'
  Assert index(lines, '  (not a git repository)') >= 0,
        \ 'outside git there are no projects: ' . string(lines)

Execute (sessions of no project here sit under Elsewhere, by their project):
  " A session that ran in the repository root belongs to the root checkout;
  " one that ran in a worktree the plugin does not know belongs to none and
  " sits directly under the group.
  call claude#session#_inject({'name': 'panel design', 'status': 'active',
        \ 'project': '/w/alpha', 'worktree': '/w/alpha', 'branch': 'main'})
  call claude#session#_inject({'name': 'registry spike', 'status': 'idle',
        \ 'project': '/w/alpha', 'worktree': '/w/alpha', 'branch': 'feature'})
  call claude#session#_inject({'name': 'E947 repro', 'status': 'closed',
        \ 'project': '/w/alpha', 'worktree': '/w/alpha-wt', 'branch': 'hotfix'})
  call claude#panel#_grouping('projects')
  call claude#panel#open()
  let lines = claude#panel#_lines()
  let text  = join(lines, "\n")
  Assert text =~# '\n▾ Elsewhere (3)\n',       'the group: ' . text
  Assert text =~# '\n  ▾ alpha (root)\n',  'its project: ' . text
  Assert text =~# '    ● panel design',       'active session missing'
  Assert text =~# '    ○ registry spike',     'idle session missing'
  Assert text =~# '\n  ✗ E947 repro',         'projectless session: ' . text

Execute (a session in a project the store no longer knows gets a missing row):
  " No real project to look up from this (non-git) cwd, so the panel makes up
  " a row for the one the record names rather than losing the session. A
  " session from a sub-room of an older build is in a project of its own.
  call claude#session#_inject({'name': 'codereview', 'status': 'active',
        \ 'project': '/w/datadog-agent',
        \ 'worktree': '/w/datadog-agent/.vim-workspace/fleet/datadog-agent',
        \ 'branch': 'room/fleet', 'room': 'fleet'})
  call claude#session#_inject({'name': 'icons', 'status': 'idle',
        \ 'project': '/w/datadog-agent',
        \ 'worktree': '/w/datadog-agent/.vim-workspace/fleet/ui/datadog-agent',
        \ 'branch': 'room/fleet--ui', 'room': 'fleet/ui'})
  call claude#panel#_grouping('projects')
  call claude#panel#open()
  let lines = claude#panel#_lines()
  let at = match(lines, 'fleet — (missing)')
  Assert at >= 0, 'project missing: ' . string(lines)
  Assert lines[at + 1] =~# '^    ● codereview', 'its session: ' . lines[at + 1]
  Assert lines[at + 2] =~# 'fleet/ui — (missing)$', 'a project of its own: '
        \ . lines[at + 2]
  Assert lines[at + 3] =~# '^    ○ icons', 'and its session: ' . lines[at + 3]

Execute (the state view groups each status by project):
  call claude#session#_inject({'name': 'prototype', 'status': 'waiting',
        \ 'project': '/w/alpha', 'worktree': '/w/alpha/.vim-workspace/panel/alpha',
        \ 'branch': 'panel', 'room': 'panel'})
  call claude#session#_inject({'name': 'on main', 'status': 'waiting',
        \ 'project': '/w/alpha', 'worktree': '/w/alpha', 'branch': 'main'})
  call claude#session#_inject({'name': 'loose', 'status': 'waiting',
        \ 'worktree': '/tmp/scratch', 'branch': 'main'})
  call claude#panel#open()
  let lines = claude#panel#_lines()
  let at = match(lines, 'Needs you')
  Assert lines[at + 1] =~# '^  ⚠\? \=.*loose\|^  \S loose',
        \ 'a session in no project sits directly under the group: '
        \ . string(lines)
  let panel = index(lines, '  ▾ panel — (missing)')
  Assert panel > at, 'project row missing: ' . string(lines)
  Assert lines[panel + 1] =~# '^    \S prototype ', 'its session: ' . string(lines)
  Assert index(lines, '  ▾ alpha (root)') > at, 'root row: ' . string(lines)

Execute (folding a room in one status group leaves it open in another):
  call claude#session#_inject({'name': 'asking', 'status': 'waiting',
        \ 'project': '/w/alpha', 'worktree': '/w/alpha', 'branch': 'main'})
  call claude#session#_inject({'name': 'busy', 'status': 'active',
        \ 'project': '/w/alpha', 'worktree': '/w/alpha', 'branch': 'main'})
  call claude#panel#open()
  call win_gotoid(bufwinid(claude#panel#bufnr()))
  call cursor(1, 1)
  call search('alpha (root)', 'W')
  normal za
  let text = join(claude#panel#_lines(), "\n")
  Assert text !~# 'asking', 'the folded room hides its session'
  Assert text =~# 'busy',   'the same room under Working stays open'

Execute (sessions of one checkout share a single project row):
  call claude#session#_inject({'name': 'a', 'status': 'active',
        \ 'project': '/w/repo', 'worktree': '/w/repo',    'branch': 'main'})
  call claude#session#_inject({'name': 'b', 'status': 'active',
        \ 'project': '/w/repo', 'worktree': '/w/repo', 'branch': 'topic'})
  call claude#panel#open()
  let lines = claude#panel#_lines()
  let projects = filter(copy(lines), {_, l -> l =~# '^  [▾▸] '})
  AssertEqual 1, len(projects),
        \ 'both are in the one root checkout: ' . string(projects)

Execute (the header counts live sessions only):
  call claude#session#_inject({'name': 'a', 'status': 'active',
        \ 'worktree': '/w/x', 'branch': 'main'})
  call claude#session#_inject({'name': 'b', 'status': 'idle',
        \ 'worktree': '/w/x', 'branch': 'main'})
  call claude#session#_inject({'name': 'c', 'status': 'closed',
        \ 'worktree': '/w/x', 'branch': 'main'})
  call claude#panel#open()
  Assert claude#panel#_lines()[0] =~# '(2)$',
        \ 'closed sessions must not be counted as live'

" ── glyphs ───────────────────────────────────────────────────────────────────

Execute (ascii mode swaps the glyph set):
  let g:claude_panel_ascii = 1
  AssertEqual '[A]', claude#panel#icon('active')
  AssertEqual '[I]', claude#panel#icon('idle')
  AssertEqual '[C]', claude#panel#icon('closed')
  call claude#session#_inject({'name': 'ascii one', 'status': 'active',
        \ 'worktree': '/w/x', 'branch': 'main'})
  call claude#panel#open()
  Assert join(claude#panel#_lines(), "\n") =~# '\[A\] ascii one'

Execute (a long name is trimmed from the end, keeping its opening words):
  let g:_saved_width = get(g:, 'claude_panel_width', 35)
  let g:claude_panel_width = 24
  " An empty worktree and no created/last_focus time leave the row with no
  " suffix, so the label alone decides where it gets cut.
  call claude#session#_inject({'name':
        \ 'ask me if something should be renamed before we ship',
        \ 'status': 'idle', 'worktree': '', 'created': 0})
  call claude#panel#open()
  let rows = filter(claude#panel#_lines(), {_, l -> l =~# 'ask me'})
  AssertEqual 1, len(rows)
  AssertEqual '  ○ ask me if somethin…', rows[0],
        \ 'expected the tail cut, opening words kept'
  let g:claude_panel_width = g:_saved_width

Execute (g:claude_panel_icons overrides individual glyphs):
  let g:claude_panel_icons = {'active': '>>'}
  AssertEqual '>>', claude#panel#icon('active')
  AssertEqual '○',  claude#panel#icon('idle')
  unlet g:claude_panel_icons
  let g:claude_panel_icons = {}

" ── duplicate names ──────────────────────────────────────────────────────────

Execute (same-named sessions in one group get a display-only suffix):
  call claude#session#_inject({'name': 'work', 'status': 'active',
        \ 'worktree': '/w/x', 'branch': 'main'})
  call claude#session#_inject({'name': 'work', 'status': 'active',
        \ 'worktree': '/w/x', 'branch': 'main'})
  call claude#panel#open()
  let rows = filter(claude#panel#_lines(), {_, l -> l =~# 'work'})
  AssertEqual 2, len(rows), 'both should be listed: ' . string(rows)
  Assert rows[0] !~# '(2)', 'the first duplicate keeps its bare name'
  Assert rows[1] =~# 'work (2)', 'the second should be suffixed: ' . rows[1]
  " The stored names are untouched.
  let names = map(claude#session#list(), {_, r -> r.name})
  AssertEqual ['work', 'work'], names

" ── closed sessions ──────────────────────────────────────────────────────────

Execute (show_closed=0 removes closed rows from the tree):
  call claude#session#_inject({'name': 'live one', 'status': 'active',
        \ 'worktree': '/w/x', 'branch': 'main'})
  call claude#session#_inject({'name': 'dead one', 'status': 'closed',
        \ 'worktree': '/w/x', 'branch': 'main'})
  let g:claude_panel_show_closed = 0
  call claude#panel#open()
  let text = join(claude#panel#_lines(), "\n")
  let g:claude_panel_show_closed = 1
  Assert text =~# 'live one',  'live sessions must still render'
  Assert text !~# 'dead one',  'closed sessions should be hidden'

" ── folding ──────────────────────────────────────────────────────────────────

Execute (folding a group hides its children and persists across redraws):
  call claude#session#_inject({'name': 'hidden me', 'status': 'active',
        \ 'project': '/w/alpha', 'worktree': '/w/alpha', 'branch': 'main'})
  call claude#panel#_grouping('projects')
  call claude#panel#open()
  call win_gotoid(bufwinid(claude#panel#bufnr()))
  Assert join(claude#panel#_lines(), "\n") =~# 'hidden me'
  " Put the cursor on the Elsewhere group and fold it.
  call cursor(1, 1)
  call search('^▾ Elsewhere', 'W')
  normal za
  let text = join(claude#panel#_lines(), "\n")
  Assert text =~# '▸ Elsewhere', 'the group should be marked collapsed'
  Assert text !~# 'hidden me', 'collapsed children must not render'
  " A rebuild keeps the fold shut.
  call claude#panel#refresh()
  Assert join(claude#panel#_lines(), "\n") !~# 'hidden me'
  normal za
  Assert join(claude#panel#_lines(), "\n") =~# 'hidden me',
        \ 'unfolding should bring the children back'

" ── colours ──────────────────────────────────────────────────────────────────
"
" The panel is coloured with NERDTree's palette so the two halves of the
" sidebar read as one thing. NERDTree's own highlight groups are preferred
" when they exist, so restyling NERDTree restyles the panel too.

Execute (the panel falls back to the groups NERDTree uses):
  " No precondition on NERDTreeDir existing: highlight groups are global and
  " leak between suites, and these three no longer depend on it anyway --
  " project, branch and the name follow their own colours or NERDTreeFile,
  " which nothing has defined at this point.
  call claude#panel#open()
  Assert execute('highlight ClaudeSessionBranch') =~# 'links to Type'
  Assert execute('highlight ClaudeSessionName')     =~# 'links to Normal'
  Assert execute('highlight ClaudeSessionHeader')   =~# 'links to Statement'

Execute (NERDTree's own groups are picked up once they exist):
  " Session names follow NERDTreeFile; branch deliberately does not follow
  " any NERDTree group, so this is exercised through the name.
  call claude#panel#open()
  Assert execute('highlight ClaudeSessionName') =~# 'links to Normal'
  " Stand in for NERDTree's syntax file being sourced.
  highlight default link NERDTreeFile Normal
  call claude#panel#_relink()
  Assert execute('highlight ClaudeSessionName') =~# 'links to NERDTreeFile',
        \ 'the fallback should be upgraded to NERDTree''s group'
  highlight link NERDTreeFile NONE

Execute (project and branch keep their own colours when NERDTree loads):
  " They must not follow NERDTreeDir: two levels pointing at one group would
  " collapse into a single colour the moment NERDTree's syntax file was read.
  call claude#panel#open()
  highlight default link NERDTreeDir Directory
  call claude#panel#_relink()
  Assert execute('highlight ClaudeSessionProject') =~# 'links to Statement'
  Assert execute('highlight ClaudeSessionBranch')   =~# 'links to Type'
  highlight link NERDTreeDir NONE

Execute (project, branch and the session name are three different colours):
  call claude#panel#open()
  let seen = {}
  for g in ['ClaudeSessionProject', 'ClaudeSessionBranch', 'ClaudeSessionName']
    let seen[synIDattr(synIDtrans(hlID(g)), 'name')] = 1
  endfor
  AssertEqual 3, len(keys(seen)),
        \ 'each level must resolve to its own group, got ' . string(keys(seen))

Execute (a colour the user chose is never overwritten):
  call claude#panel#open()
  highlight! link ClaudeSessionName ErrorMsg
  highlight default link NERDTreeFile Normal
  call claude#panel#_relink()
  Assert execute('highlight ClaudeSessionName') =~# 'links to ErrorMsg',
        \ 'a user override must survive the NERDTree upgrade'
  highlight link ClaudeSessionName NONE
  highlight link NERDTreeFile NONE

Execute (every panel element is highlighted):
  call claude#session#_inject({'name': 'live', 'status': 'active',
        \ 'project': '/w/x', 'worktree': '/w/x', 'branch': 'main'})
  call claude#session#_inject({'name': 'gone', 'status': 'closed',
        \ 'project': '/w/x', 'worktree': '/w/x-wt', 'branch': 'main',
        \ 'room': 'gone-room'})
  call claude#panel#_grouping('projects')
  call claude#panel#open()
  call win_gotoid(bufwinid(claude#panel#bufnr()))
  let seen = {}
  for l in range(1, line('$'))
    for c in range(1, max([1, strlen(getline(l))]))
      let n = synIDattr(synID(l, c, 1), 'name')
      if !empty(n) | let seen[n] = 1 | endif
    endfor
  endfor
  for g in ['ClaudeSessionHeader', 'ClaudeSessionProject',
        \ 'ClaudeSessionWorktree', 'ClaudeSessionBranch',
        \ 'ClaudeSessionMarker', 'ClaudeSessionActive',
        \ 'ClaudeSessionName', 'ClaudeSessionClosed',
        \ 'ClaudeSessionNameClosed', 'ClaudeSessionHelp']
    Assert has_key(seen, g), g . ' was not applied to any panel text'
  endfor
