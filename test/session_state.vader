" Tests for the waiting signal: what the bottom of a Claude terminal is read
" as, and how that reaches claude#session#status().
"
" The classifier is the whole reason the panel can group by state rather than
" by place, so it is tested on captured text first and against a real terminal
" second.

Before:
  call claude#session#_reset()
  call claude#store#_reset()
  let g:_saved_cmd   = get(g:, 'claude_cmd', 'claude')
  let g:_saved_store = get(g:, 'claude_session_store', '')
  let g:_saved_idle  = get(g:, 'claude_panel_idle_secs', 30)
  let g:_saved_hook_state = get(g:, 'claude_panel_hook_state', 0)
  let g:_saved_hook_root = get(g:, 'claude_panel_hook_state_root', '')
  let g:_saved_hook_ttl = get(g:, 'claude_panel_hook_state_ttl_secs', 15)
  let g:claude_panel_hook_state = 0
  let g:claude_panel_hook_state_ttl_secs = 15
  let g:claude_cmd   = 'sleep 30'
  let g:_dir = tempname()
  let g:claude_panel_hook_state_root = g:_dir . '/hook-state'
  call mkdir(g:_dir, 'p')
  let g:claude_session_store = g:_dir . '/sessions.json'

After:
  for b in claude#session#bufnrs()
    call claude#session#stop_job(b)
    silent! execute 'bwipeout! ' . b
  endfor
  call claude#session#_reset()
  call claude#store#_reset()
  let g:claude_cmd            = g:_saved_cmd
  let g:claude_session_store  = g:_saved_store
  let g:claude_panel_idle_secs = g:_saved_idle
  let g:claude_panel_hook_state = g:_saved_hook_state
  let g:claude_panel_hook_state_root = g:_saved_hook_root
  let g:claude_panel_hook_state_ttl_secs = g:_saved_hook_ttl
  silent! unlet g:claude_panel_waiting_pat
  silent! unlet g:claude_panel_working_pat
  call delete(g:_dir, 'rf')

" ── reading the terminal ─────────────────────────────────────────────────────

Execute (the spinner footer means working):
  AssertEqual 'active', claude#session#_classify(
        \ "✽ Frobnicating… (12s · esc to interrupt)")

Execute (a numbered choice means the session is waiting for you):
  AssertEqual 'waiting', claude#session#_classify(
        \ join(['Do you want to make this edit to panel.vim?',
        \       '❯ 1. Yes',
        \       '  2. No, and tell Claude what to do differently'], "\n"))

Execute (a numbered list without the pointer is still a question):
  AssertEqual 'waiting', claude#session#_classify(
        \ "Pick one:\n 1. Keep going\n 2. Stop")

Execute (a yes/no prompt is a question too):
  AssertEqual 'waiting', claude#session#_classify('Overwrite it? (y/n)')

Execute (an empty prompt box says nothing either way):
  AssertEqual '', claude#session#_classify("╭──────────╮\n│ >        │\n╰──────────╯")

Execute (nothing on the screen is not an answer):
  AssertEqual '', claude#session#_classify('')

Execute (working wins over a question left further up the screen):
  " The spinner is only drawn while Claude is not waiting for anything, so a
  " stale numbered list above it must not outrank it.
  AssertEqual 'active', claude#session#_classify(
        \ "❯ 1. Yes\n✽ Working… (esc to interrupt)")

Execute (both patterns are configurable):
  let g:claude_panel_working_pat = 'BUSY'
  let g:claude_panel_waiting_pat = 'ASKING'
  AssertEqual 'active',  claude#session#_classify('now BUSY doing it')
  AssertEqual 'waiting', claude#session#_classify('now ASKING you')
  AssertEqual '',        claude#session#_classify('esc to interrupt'),
        \ 'the default pattern is replaced, not added to'

" ── optional hook records ────────────────────────────────────────────────────

Execute (hook records are ignored until explicitly enabled):
  let rec = {'id': 'hook-1', 'provider': 'claude'}
  let path = g:claude_panel_hook_state_root . '/claude/hook-1.json'
  call mkdir(fnamemodify(path, ':h'), 'p')
  call writefile([json_encode({'version': 1, 'provider': 'claude',
        \ 'session_id': 'hook-1', 'state': 'waiting',
        \ 'updated_at': localtime()})], path)
  AssertEqual '', claude#session#_hook_state(rec)

Execute (fresh matching hook records refine a live state):
  let g:claude_panel_hook_state = 1
  let rec = {'id': 'hook-2', 'provider': 'pi'}
  let path = g:claude_panel_hook_state_root . '/pi/hook-2.json'
  call mkdir(fnamemodify(path, ':h'), 'p')
  for state in ['active', 'waiting', 'idle']
    call writefile([json_encode({'version': 1, 'provider': 'pi',
          \ 'session_id': 'hook-2', 'state': state,
          \ 'updated_at': localtime()})], path)
    AssertEqual state, claude#session#_hook_state(rec)
  endfor

Execute (bad, stale and foreign hook records fall back silently):
  let g:claude_panel_hook_state = 1
  let rec = {'id': 'hook-3', 'provider': 'claude'}
  let path = g:claude_panel_hook_state_root . '/claude/hook-3.json'
  call mkdir(fnamemodify(path, ':h'), 'p')
  call writefile(['not json'], path)
  AssertEqual '', claude#session#_hook_state(rec)
  call writefile([json_encode({'version': 1, 'provider': 'pi',
        \ 'session_id': 'hook-3', 'state': 'waiting',
        \ 'updated_at': localtime()})], path)
  AssertEqual '', claude#session#_hook_state(rec)
  call writefile([json_encode({'version': 1, 'provider': 'claude',
        \ 'session_id': 'hook-3', 'state': 'bogus',
        \ 'updated_at': localtime()})], path)
  AssertEqual '', claude#session#_hook_state(rec)
  call writefile([json_encode({'version': 1, 'provider': 'claude',
        \ 'session_id': 'hook-3', 'state': 'waiting',
        \ 'updated_at': localtime() - 16})], path)
  AssertEqual '', claude#session#_hook_state(rec)
  call writefile([json_encode({'version': 1, 'provider': 'claude',
        \ 'session_id': 'hook-3', 'state': 'waiting',
        \ 'updated_at': localtime() + 3600})], path)
  AssertEqual '', claude#session#_hook_state(rec),
        \ 'a record stamped in the future is a broken clock, not evidence'

Execute (a hook cannot call a session closed):
  let g:claude_panel_hook_state = 1
  let rec = {'id': 'hook-4', 'provider': 'claude'}
  let path = g:claude_panel_hook_state_root . '/claude/hook-4.json'
  call mkdir(fnamemodify(path, ':h'), 'p')
  call writefile([json_encode({'version': 1, 'provider': 'claude',
        \ 'session_id': 'hook-4', 'state': 'closed',
        \ 'updated_at': localtime()})], path)
  AssertEqual '', claude#session#_hook_state(rec),
        \ 'liveness is the session layer''s to decide, and poll() would reap it'

Execute (the record root follows the writers when it is not configured):
  let g:claude_panel_hook_state = 1
  let g:claude_panel_hook_state_root = ''
  let rec = {'id': 'hook-5', 'provider': 'claude'}
  let base = empty($XDG_RUNTIME_DIR) ? '/tmp' : $XDG_RUNTIME_DIR
  let path = base . '/claude-vim-status/claude/hook-5.json'
  call mkdir(fnamemodify(path, ':h'), 'p')
  call writefile([json_encode({'version': 1, 'provider': 'claude',
        \ 'session_id': 'hook-5', 'state': 'active',
        \ 'updated_at': localtime()})], path)
  AssertEqual 'active', claude#session#_hook_state(rec)
  call delete(path)

" ── how it reaches the status ────────────────────────────────────────────────

Execute (a session whose terminal is asking a question is waiting):
  " A stand-in for Claude: fill the screen, print a permission prompt at the
  " bottom of it the way Claude does, then stay alive. The blank lines matter —
  " s:term_tail() reads the bottom rows of the terminal, not the last thing
  " written to it.
  let script = g:_dir . '/asks.sh'
  call writefile(['#!/bin/sh', 'i=0',
        \ 'while [ $i -lt 60 ]; do echo; i=$((i+1)); done',
        \ 'echo "Do you want to proceed?"',
        \ 'echo "1. Yes"', 'exec sleep 30'], script)
  call setfperm(script, 'rwxr-xr-x')
  let g:claude_cmd = script

  let id = claude#session#new('asker', 'new')
  for _ in range(100)
    call claude#session#poll()
    if claude#session#status(id) ==# 'waiting'
      break
    endif
    sleep 20m
  endfor
  AssertEqual 'waiting', claude#session#status(id)
  AssertEqual 'waiting', claude#session#get(id).status,
        \ 'the poll should have written it back to the record'

Execute (a fresh hook state precedes terminal fallback for a running job):
  let g:claude_panel_hook_state = 1
  let id = claude#session#new('hooked', 'new')
  let path = g:claude_panel_hook_state_root . '/claude/' . id . '.json'
  call mkdir(fnamemodify(path, ':h'), 'p')
  call writefile([json_encode({'version': 1, 'provider': 'claude',
        \ 'session_id': id, 'state': 'waiting', 'updated_at': localtime()})], path)
  AssertEqual 'waiting', claude#session#status(id)

Execute (a hook reports background work the terminal never printed):
  let g:claude_panel_hook_state = 1
  let g:claude_panel_idle_secs = 0
  let id = claude#session#new('backgrounded', 'new')
  let path = g:claude_panel_hook_state_root . '/claude/' . id . '.json'
  call mkdir(fnamemodify(path, ':h'), 'p')
  call writefile([json_encode({'version': 1, 'provider': 'claude',
        \ 'session_id': id, 'state': 'active', 'updated_at': localtime()})], path)
  AssertEqual 'active', claude#session#status(id),
        \ 'a quiet terminal past the idle timer is still working'

  call writefile([json_encode({'version': 1, 'provider': 'claude',
        \ 'session_id': id, 'state': 'idle', 'updated_at': localtime()})], path)
  AssertEqual 'idle', claude#session#status(id),
        \ 'and the hook can settle it again without waiting for the timer'

Execute (a working terminal outranks a hook still asking for attention):
  let g:claude_panel_hook_state = 1
  let g:claude_panel_working_pat = 'esc to interrupt'
  let id = claude#session#new('resumed', 'new')
  let path = g:claude_panel_hook_state_root . '/claude/' . id . '.json'
  call mkdir(fnamemodify(path, ':h'), 'p')
  call writefile([json_encode({'version': 1, 'provider': 'claude',
        \ 'session_id': id, 'state': 'waiting', 'updated_at': localtime()})], path)
  let rec = claude#session#get(id)
  let rec.term_tail = 'esc to interrupt'
  AssertEqual 'active', claude#session#status(id),
        \ 'the prompt was answered; only the resolving event went missing'

Execute (a hook record cannot keep a dead job alive):
  let g:claude_panel_hook_state = 1
  let id = claude#session#new('killed', 'new')
  let path = g:claude_panel_hook_state_root . '/claude/' . id . '.json'
  call mkdir(fnamemodify(path, ':h'), 'p')
  call writefile([json_encode({'version': 1, 'provider': 'claude',
        \ 'session_id': id, 'state': 'active', 'updated_at': localtime()})], path)
  let job = term_getjob(claude#session#get(id).bufnr)
  call job_stop(job, 'kill')
  for _ in range(100)
    if job_status(job) !=# 'run'
      break
    endif
    sleep 20m
  endfor
  AssertEqual 'closed', claude#session#status(id)

Execute (a session printing nothing falls back to the idle timer):
  let id = claude#session#new('quiet', 'new')
  call claude#session#poll()
  AssertEqual 'active', claude#session#status(id),
        \ 'it produced output just now, whatever that output was'

  let g:claude_panel_idle_secs = 0
  AssertEqual 'idle', claude#session#status(id),
        \ 'with no timer left and nothing on screen, it is idle'

Execute (a fabricated record still carries its status verbatim):
  call claude#session#_inject({'id': 'fake', 'name': 'pinned',
        \ 'status': 'waiting', 'term_tail': 'esc to interrupt'})
  AssertEqual 'waiting', claude#session#status('fake'),
        \ 'there is no job behind it to read'

Execute (waiting is a live status, and sorts with the live ones):
  call claude#session#_inject({'id': 'w', 'name': 'asking',
        \ 'status': 'waiting'})
  call claude#session#_inject({'id': 'c', 'name': 'finished',
        \ 'status': 'closed'})
  AssertEqual 1, len(claude#session#live()),
        \ 'a waiting session is running, so it is live'
  AssertEqual ['w', 'c'], map(copy(claude#session#list()), {_, r -> r.id}),
        \ 'live sessions sort before finished ones'
